# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_WORKSHEET_NAME=Sheet1
# Optional (Railway): base64 of the service-account JSON. If set, decoded at
# startup to GOOGLE_SERVICE_ACCOUNT_JSON_PATH (or /tmp/service-account.json
# when the path is blank).
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Notion (optional; web trigger skips notion-sync if either is blank)
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# Web trigger — required to POST /run/social
RUN_SECRET=

# QA compiler pass: true (default) = 2 Gemini calls/row; false = 1 call/row
# (skips QA) to stretch a limited free-tier quota. CLI: --no-qa overrides.
QA_COMPILER_ENABLED=true

# Default Storelli IG follower count, used when the sheet doesn't carry a
# per-row Followers column. Used to compute views/followers ratio -> PERFORMANCE.
STORELLI_IG_FOLLOWER_COUNT=170000

# Slack bot — enables the interactive Marketing Brain in Slack.
# Create a Slack app, add bot scope `chat:write`, subscribe to `app_mention`,
# and point the Request URL at https://<railway-url>/slack/events.
# Missing values do not crash startup; /slack/events returns 503 until set.
# SLACK_WEBHOOK_URL above stays optional and unchanged (used for run reports).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# OPTIONAL ENRICHMENT ONLY — private Instagram Insights (saves/reach/
# impressions/demographics). Public mode works fully WITHOUT these; leaving them
# blank is a normal, healthy state and never blocks the brain.
# Instagram Insights — owned-media metrics enrichment (was the primary path;
# manual SOCIAL_METRICS_IMPORT_STAGING paste is a fallback). Official Meta Graph
# API only — never scrapes, never uses cookies, only reads the Storelli-owned
# IG business account. Token needs: instagram_manage_insights + instagram_basic
# (+ pages_read_engagement if using the Page-linked login flow). Missing config
# fails cleanly; `pull-instagram-metrics --dry-run` reports what would fill.
INSTAGRAM_ACCESS_TOKEN=
# ...or provide META_ACCESS_TOKEN instead (either is accepted):
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# ...or IG_USER_ID (either is accepted):
IG_USER_ID=
# Graph API version (default v21.0 if unset):
META_API_VERSION=
# Optional — only if token refresh/debug is wired up later:
META_APP_ID=
META_APP_SECRET=

# Self-updating intelligence scheduler (weekly, bounded, fail-soft). Orchestrates
# the existing internal (Storelli evidence) + external (inspiration) jobs. The
# web app runs it IN-PROCESS on boot (src/scheduler.py) — no external cron is
# needed. It wakes hourly and asks the run log whether a refresh is due, so a
# restart never loses or double-fires the schedule, and the orchestrator's run
# lock keeps two replicas (or a dashboard click) from overlapping.
# `python -m src.main refresh-intelligence` still works for a manual run.
INTELLIGENCE_REFRESH_ENABLED=true
INTELLIGENCE_REFRESH_CADENCE_DAYS=7
INTELLIGENCE_REFRESH_STALE_LOCK_MIN=90
INTELLIGENCE_MAX_ACTIVE_QUERIES=12
INTELLIGENCE_STALE_TOLERANCE_DAYS=2

# PUBLIC MODE (primary): owned Storelli discovery runs on Apify — no Meta API,
# no Instagram login, no manual exports. Only APIFY_TOKEN + this handle are
# needed. The handle defaults to `storellisoccer` (derived from the POC sheet's
# own links, 170/170 consistent) and is NOT a secret.
STORELLI_INSTAGRAM_HANDLE=storellisoccer
OWNED_SCAN_MAX_RESULTS=30
OWNED_SCAN_LOOKBACK_DAYS=30
OWNED_SCAN_BUFFER_DAYS=3

# Storelli-OWNED TikTok handle (e.g. storellisoccer). Empty = no owned TikTok.
# ONLY this exact handle can enter the internal evidence pipeline; owned-TikTok
# metrics are limited (no official API integration here). Never blocks Instagram.
STORELLI_TIKTOK_HANDLE=

# Canonical posting timezone for posting-time analytics (e.g. America/New_York).
# EMPTY BY DEFAULT AND DELIBERATELY SO: Apify/Meta timestamps are UTC and the
# project has never recorded which local timezone Storelli publishes on, so
# posting-time answers stay in UTC and SAY they are UTC until this is set.
# An unknown zone name falls back to UTC with a warning rather than crashing.
STORELLI_POSTING_TIMEZONE=

# Analysis age gate: a reel is NOT analyzed (not tagged, no Gemini call) until it
# is at least this many days old, because a post that has only been up a couple
# of days has not had time to collect engagement and its metrics are unrealistic.
# Blank = follow PERFORMANCE_MATURITY_DAYS (one week). Clamped 0-90. Ingestion is
# unaffected: new reels are still appended immediately and picked up for analysis
# automatically once they cross the threshold. Rows with no POST_DATE (the
# pre-existing library) count as old enough.
ANALYSIS_MIN_AGE_DAYS=

# Weekly scheduler controls. INTELLIGENCE_SCHEDULER_ENABLED=false turns the
# in-process schedule off (manual/CLI runs still work). CHECK_MINUTES is how
# often the thread asks "is a refresh due?" (5-1440, default 60) — it does NOT
# sleep for a week. STARTUP_DELAY_SECONDS is the settle time before the first
# check so a redeploy loop never fires a heavy job (0-3600, default 120).
INTELLIGENCE_SCHEDULER_ENABLED=true
INTELLIGENCE_SCHEDULER_CHECK_MINUTES=60
INTELLIGENCE_SCHEDULER_STARTUP_DELAY_SECONDS=120

# How many reels ONE scheduled refresh may analyze. Video tagging and Slack
# conversation share the SAME Gemini quota, and tagging costs 2 calls per reel
# with QA on — so an unbounded weekly run can eat a whole day's free-tier
# allowance, after which every Slack reply silently drops to the terse
# deterministic voice. Unanalyzed reels stay eligible and are picked up next run.
# Set 0 for no limit (sensible on a paid tier). QA_COMPILER_ENABLED=false halves
# the cost per reel if you'd rather analyze more per run.
INTELLIGENCE_ANALYZE_LIMIT=6

# Weekly digest. After each scheduled refresh a short summary of what actually
# changed is sent as a DIRECT MESSAGE to one person — NOT broadcast to the shared
# channel. DIGEST_SLACK_USER_ID (U…) is preferred and needs no extra scope; the
# email fallback uses users.lookupByEmail and needs the `users:read.email` scope.
# DIGEST_SLACK_CHANNEL_ENABLED=true would post it to the SLACK_WEBHOOK_URL
# channel for everyone — deliberately off. Email is
# entirely opt-in: with DIGEST_EMAIL_TO / SMTP_HOST / SMTP_FROM unset nothing is
# ever emailed. Delivery is best-effort — a Slack outage or a bad SMTP password
# never turns a successful refresh into a failed one.
DIGEST_ENABLED=true
DIGEST_SLACK_USER_ID=
DIGEST_SLACK_EMAIL=jacopo.viola@storellisports.com
DIGEST_SLACK_CHANNEL_ENABLED=false
DIGEST_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
